{
  "name": "temoto-proxy",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:typescript && node scripts/verify-build.mjs",
    "build:typescript": "tsc -p tsconfig.json",
    "package": "npm run check && node scripts/package-extension.mjs",
    "package:store-bootstrap": "npm run check && node scripts/package-extension.mjs --store-bootstrap",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/chrome": "^0.2.6",
    "typescript": "^7.0.2"
  }
}
