{
  "name": "temoto-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/verify-build.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "package:store-bootstrap": "npm run build && node scripts/package-extension.mjs --store-bootstrap",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  }
}
