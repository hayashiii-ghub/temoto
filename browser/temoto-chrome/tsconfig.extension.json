{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"],
    "rootDir": "src/extension",
    "outDir": "dist/client",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/extension/**/*.ts"]
}
